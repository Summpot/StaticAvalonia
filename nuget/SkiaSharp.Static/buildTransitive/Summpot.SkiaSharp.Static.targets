<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_SkiaSharpStaticRoot>$(MSBuildThisFileDirectory)../</_SkiaSharpStaticRoot>
  </PropertyGroup>

  <!-- Linux C++ standard library configuration:
       Setting LinkStandardCPlusPlusLibrary=true prevents NativeAOT's Microsoft.NETCore.Native.Unix.targets
       from linking libstdc++compat.a, preventing duplicate 'std::nothrow' symbol collisions with static libstdc++. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and ('$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))))">
    <LinkStandardCPlusPlusLibrary Condition="'$(LinkStandardCPlusPlusLibrary)' == ''">true</LinkStandardCPlusPlusLibrary>
  </PropertyGroup>

  <!-- Configuration for NativeAOT / Static Linking -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <DirectPInvoke Include="libSkiaSharp" />
    <DirectPInvoke Include="libHarfBuzzSharp" />

    <!-- Windows x64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' and $([MSBuild]::IsOSPlatform('Windows')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/win-x64/native/skia.lib;
                            $(_SkiaSharpStaticRoot)runtimes/win-x64/native/SkiaSharp.lib;
                            $(_SkiaSharpStaticRoot)runtimes/win-x64/native/libHarfBuzzSharp.lib" />

    <!-- Windows arm64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' and $([MSBuild]::IsOSPlatform('Windows')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/win-arm64/native/skia.lib;
                            $(_SkiaSharpStaticRoot)runtimes/win-arm64/native/SkiaSharp.lib;
                            $(_SkiaSharpStaticRoot)runtimes/win-arm64/native/libHarfBuzzSharp.lib" />

    <!-- Linux x64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' and $([MSBuild]::IsOSPlatform('Linux')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/linux-x64/native/libskia.a;
                            $(_SkiaSharpStaticRoot)runtimes/linux-x64/native/libSkiaSharp.a;
                            $(_SkiaSharpStaticRoot)runtimes/linux-x64/native/libHarfBuzzSharp.a" />

    <!-- Linux arm64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'linux-arm64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' and $([MSBuild]::IsOSPlatform('Linux')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/linux-arm64/native/libskia.a;
                            $(_SkiaSharpStaticRoot)runtimes/linux-arm64/native/libSkiaSharp.a;
                            $(_SkiaSharpStaticRoot)runtimes/linux-arm64/native/libHarfBuzzSharp.a" />

    <!-- macOS x64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'osx-x64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64' and $([MSBuild]::IsOSPlatform('OSX')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/osx-x64/native/libskia.a;
                            $(_SkiaSharpStaticRoot)runtimes/osx-x64/native/libSkiaSharp.a;
                            $(_SkiaSharpStaticRoot)runtimes/osx-x64/native/libHarfBuzzSharp.a" />

    <!-- macOS arm64 -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64' and $([MSBuild]::IsOSPlatform('OSX')))"
                   Include="$(_SkiaSharpStaticRoot)runtimes/osx-arm64/native/libskia.a;
                            $(_SkiaSharpStaticRoot)runtimes/osx-arm64/native/libSkiaSharp.a;
                            $(_SkiaSharpStaticRoot)runtimes/osx-arm64/native/libHarfBuzzSharp.a" />

    <!-- Windows Linker Dependencies -->
    <LinkerArg Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))"
               Include="d3d12.lib;dxgi.lib;d3dcompiler.lib;gdi32.lib;user32.lib;ole32.lib;fontsub.lib;usp10.lib;synchronization.lib" />

    <!-- Linux Linker Dependencies (statically link libstdc++ and libgcc for portable binaries across GLIBC distros) -->
    <LinkerArg Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')))"
               Include="-static-libstdc++ -static-libgcc -lfontconfig -lfreetype -lpthread -ldl -lm" />

    <!-- macOS Linker Dependencies -->
    <LinkerArg Condition="'$(RuntimeIdentifier)' == 'osx-x64' or '$(RuntimeIdentifier)' == 'osx-arm64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX')))"
               Include="-framework Metal -framework CoreGraphics -framework CoreText -framework Foundation" />
  </ItemGroup>
</Project>
